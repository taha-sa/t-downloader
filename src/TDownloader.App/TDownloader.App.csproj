<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <Version>1.1.0</Version>
    <ApplicationIcon>../../assets/logo/logo.ico</ApplicationIcon>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TDownloader</AssemblyName>
    <RootNamespace>TDownloader.App</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../assets/logo/logo.ico" LogicalName="logo.ico" />
    <EmbeddedResource Include="Resources/Family/t-bridge/32.png" LogicalName="Family.t-bridge.32.png" />
    <EmbeddedResource Include="Resources/Family/t-bridge/64.png" LogicalName="Family.t-bridge.64.png" />
    <EmbeddedResource Include="Resources/Family/t-downloader/32.png" LogicalName="Family.t-downloader.32.png" />
    <EmbeddedResource Include="Resources/Family/t-downloader/64.png" LogicalName="Family.t-downloader.64.png" />
    <EmbeddedResource Include="Resources/Family/t-ramcash/32.png" LogicalName="Family.t-ramcash.32.png" />
    <EmbeddedResource Include="Resources/Family/t-ramcash/64.png" LogicalName="Family.t-ramcash.64.png" />
    <EmbeddedResource Include="Resources/Family/t-desktree/32.png" LogicalName="Family.t-desktree.32.png" />
    <EmbeddedResource Include="Resources/Family/t-desktree/64.png" LogicalName="Family.t-desktree.64.png" />
    <EmbeddedResource Include="Resources/Family/t-desk-viewer/32.png" LogicalName="Family.t-desk-viewer.32.png" />
    <EmbeddedResource Include="Resources/Family/t-desk-viewer/64.png" LogicalName="Family.t-desk-viewer.64.png" />
    <EmbeddedResource Include="Resources/tdownloader_tamamlandi.wav" LogicalName="tdownloader_tamamlandi.wav" />
    <ProjectReference Include="..\TDownloader.Core\TDownloader.Core.csproj" />
  </ItemGroup>

  <!-- T-Suite SDK: kardes depo C:\Users\hp\Projects\t-suite (bkz. README.md). Baska yer icin: -p:TSuiteRoot=... -->
  <PropertyGroup>
    <TSuiteRoot Condition="'$(TSuiteRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\Projects\t-suite</TSuiteRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(TSuiteRoot)\src\TSuite.Diagnostics\TSuite.Diagnostics.csproj" />
    <ProjectReference Include="$(TSuiteRoot)\src\TSuite.Link\TSuite.Link.csproj" />
    <ProjectReference Include="$(TSuiteRoot)\src\TSuite.Update\TSuite.Update.csproj" />
  </ItemGroup>

  <Import Project="$(TSuiteRoot)\build\TSuite.Updater.targets" />
</Project>
