<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <Version>1.1.0</Version>
    <ApplicationIcon>../../assets/logo/logo.ico</ApplicationIcon>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TDownloader</AssemblyName>
    <RootNamespace>TDownloader.App</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../assets/logo/logo.ico" LogicalName="logo.ico" />
    <ProjectReference Include="..\TDownloader.Core\TDownloader.Core.csproj" />
  </ItemGroup>

  <!-- T-Suite SDK: kardes depo C:\Users\hp\Projects\t-suite (bkz. README.md). Baska yer icin: -p:TSuiteRoot=... -->
  <PropertyGroup>
    <TSuiteRoot Condition="'$(TSuiteRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\Projects\t-suite</TSuiteRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(TSuiteRoot)\src\TSuite.Link\TSuite.Link.csproj" />
    <ProjectReference Include="$(TSuiteRoot)\src\TSuite.Update\TSuite.Update.csproj" />
    <ProjectReference Include="$(TSuiteRoot)\src\TSuite.Updater\TSuite.Updater.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- TSuite.Updater yardimcisini (exe + dll + runtimeconfig) uygulamanin yanina kopyala -->
  <Target Name="CopyUpdater" AfterTargets="Build">
    <ItemGroup>
      <UpdaterFiles Include="$(TSuiteRoot)\src\TSuite.Updater\bin\$(Configuration)\net10.0\TSuite.Updater.*" Exclude="**\*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(UpdaterFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishUpdater" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Include="@(UpdaterFiles)" RelativePath="%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
